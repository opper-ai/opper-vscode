{
  "name": "opper-vscode",
  "displayName": "Opper",
  "description": "Use your organization\u2019s Opper models in VS Code chat, with browser sign-in and project usage tracking.",
  "icon": "images/icon.png",
  "version": "0.1.1",
  "publisher": "opperai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai",
    "chat",
    "copilot",
    "language model",
    "byok",
    "opper",
    "gdpr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opper-ai/opper-vscode.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "opper",
        "displayName": "Opper",
        "managementCommand": "opper.manage"
      }
    ],
    "commands": [
      {
        "command": "opper.manage",
        "title": "Account and Models",
        "category": "Opper"
      },
      {
        "command": "opper.chooseKinds",
        "title": "Choose What to List (Models, Pools, Routes)",
        "category": "Opper"
      },
      {
        "command": "opper.signOut",
        "title": "Sign Out",
        "category": "Opper"
      },
      {
        "command": "opper.signIn",
        "title": "Sign In",
        "category": "Opper"
      },
      {
        "command": "opper.renew",
        "title": "Renew Sign-in",
        "category": "Opper"
      },
      {
        "command": "opper.retrySave",
        "title": "Retry Saving Sign-in",
        "category": "Opper"
      },
      {
        "command": "opper.refreshModels",
        "title": "Refresh Models",
        "category": "Opper"
      },
      {
        "command": "opper.context",
        "title": "Show Last Request Context",
        "category": "Opper"
      },
      {
        "command": "opper.budget",
        "title": "Show Budget",
        "category": "Opper"
      }
    ],
    "configuration": {
      "title": "Opper",
      "properties": {
        "opper.baseUrl": {
          "type": "string",
          "default": "https://api.opper.ai",
          "markdownDescription": "Base URL of the Opper API. Point this at a self-hosted or regional gateway if you run one; the extension appends `/v3/...` itself.",
          "scope": "application"
        },
        "opper.showModels": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "List concrete catalog models \u2014 a specific provider's row, e.g. `anthropic/claude-sonnet-4.5`. Untick this and leave **Show Pools** / **Show Dynamic Routes** on to reduce the picker to Opper's own routing constructs."
        },
        "opper.showPools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "List Opper **pools** \u2014 bare model names such as `claude-sonnet-4.5` that load-balance across every provider serving that model. A pool only advertises a capability its every member has."
        },
        "opper.showDynamicRoutes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "List your org's deployed **dynamic routes** as `dynamic/<name>`. The routing graph picks the model per request."
        },
        "opper.login.clientId": {
          "type": "string",
          "default": "opper_app_p-xX3vmCeoZLEZqmycoglw",
          "scope": "application",
          "description": "Registered public OAuth client ID dedicated to VS Code. No client secret."
        },
        "opper.login.platformUrl": {
          "type": "string",
          "default": "https://platform.opper.ai",
          "scope": "application",
          "description": "Trusted browser approval origin."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "opper.retrySave",
          "when": "opper.hasPendingSave"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p . --noEmit false && node --test test/*.test.js",
    "vscode:prepublish": "npm run typecheck && node esbuild.js --production",
    "prototype:login": "node prototype/server.cjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.25.0",
    "patch-package": "8.0.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@opperai/login": "0.4.1"
  }
}
